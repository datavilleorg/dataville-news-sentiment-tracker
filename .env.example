# Optional — used only by the server-side news proxy (src/app/api/news/[keyword]).
# These are NEVER exposed to the browser.

# Dataville API key. If set, the proxy authenticates upstream requests, moving
# the app off the anonymous per-IP rate limit onto the authenticated tier.
# Get one at https://app.dataville.com/api-keys
DATAVILLE_API_KEY=

# Override the upstream Dataville base URL (defaults to https://app.dataville.com).
# DATAVILLE_API_BASE=https://app.dataville.com
